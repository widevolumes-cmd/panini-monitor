# ==============================================================================
# CONFIGURACIÓN DEL AGENTE MONITOR TIENDA PANINI (MARVEL & DC)
# Copia este archivo como `.env` para pruebas locales:
# cp .env.example .env
# ==============================================================================

# --- OPCIÓN 1: Alertas por Telegram (Recomendado - Gratis e Instantáneo) ---
# 1. Habla con @BotFather en Telegram y envía /newbot para obtener tu TOKEN
# 2. Habla con @userinfobot para obtener tu ID numérico (CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OPCIÓN 2: Alertas por Discord Webhook (Gratis) ---
# En tu servidor de Discord: Editar Canal -> Integraciones -> Webhooks -> Nuevo Webhook
DISCORD_WEBHOOK_URL=

# --- OPCIÓN 3: Alertas Push con ntfy.sh (Sin cuenta ni registro) ---
# Instala la app gratuita "ntfy" (iOS/Android) o entra a https://ntfy.sh
# y suscríbete a un nombre de canal único, por ejemplo: panini_restock_mexico_9981
NTFY_TOPIC=

# --- FILTROS Y OPCIONES AVANZADAS ---
# Deja vacío para recibir alertas de TODOS los cómics de Marvel y DC que vuelvan a stock.
# O escribe palabras clave separadas por coma (ej: Omnibus,Must Have,Spider-Man,Batman)
WATCHLIST_KEYWORDS=

# ¿Notificar también cuando se publique un cómic totalmente nuevo en la tienda? (true/false)
ALERT_ON_NEW_PRODUCTS=false

# Intervalo en segundos cuando se ejecuta en modo continuo 24/7 (300 = cada 5 minutos)
CHECK_INTERVAL_SECONDS=300

# Puerto para el servidor HTTP Keep-Alive (usado en Render / Koyeb / Fly.io)
PORT=8080
